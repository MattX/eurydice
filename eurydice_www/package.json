    "@types/react-dom": "19.1.5",
    "@vitejs/plugin-react": "4.5.0",
    "eslint": "9.27.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "16.2.0",
    "postcss": "8.5.19",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.5.3",
    "typescript-eslint": "8.32.1",
