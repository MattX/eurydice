{
  "name": "eurydice_www",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "wasm-pack build ../eurydice_wasm",
    "dev": "vite",
    "build": "npm run typecheck && vite build --ssr help/entry-server.tsx && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "test": "vitest",
    "prepare": "lezer-generator src/grammar/eurydice.grammar --typeScript -o src/grammar/eurydice.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.18.0",
    "@codemirror/language": "6.11.0",
    "@codemirror/lint": "6.8.1",
    "@codemirror/state": "6.5.2",
    "@codemirror/view": "6.30.0",
    "@lezer/highlight": "1.2.0",
    "@lezer/lr": "1.4.2",
    "@mdx-js/rollup": "3.1.0",
    "@uiw/codemirror-theme-github": "4.23.12",
    "@uiw/react-codemirror": "4.23.12",
    "chart.js": "4.4.9",
    "chartjs-chart-matrix": "^3.0.5",
    "eurydice_wasm": "file:../eurydice_wasm/pkg",
    "katex": "^0.18.1",
    "react": "19.1.0",
    "react-chartjs-2": "5.3.0",
    "react-dom": "19.1.0",
    "react-hot-toast": "^2.5.2",
    "react-resizable-panels": "^4.12.2",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-github-blockquote-alert": "^2.1.0",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@lezer/generator": "1.7.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "0.5.16",
    "@types/react": "19.1.5",
    "@types/react-dom": "19.1.5",
    "@vitejs/plugin-react": "4.5.0",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "postcss": "8.5.26",
    "prettier": "3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.5.3",
    "typescript-eslint": "8.65.0",
    "vite": "6.4.3",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-wasm": "^3.5.0",
    "vitest": "^3.2.4"
  }
}
