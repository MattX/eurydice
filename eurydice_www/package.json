    "@uiw/codemirror-theme-github": "4.23.12",
    "@uiw/react-codemirror": "4.23.12",
    "chart.js": "4.4.9",
    "chartjs-chart-matrix": "^3.0.5",
    "eurydice_wasm": "file:../eurydice_wasm/pkg",
    "katex": "^0.18.1",
    "react": "19.1.0",
    "react-chartjs-2": "5.3.0",
    "react-dom": "19.1.0",
    "react-hot-toast": "^2.5.2",
    "react-resizable-panels": "^4.12.2",
